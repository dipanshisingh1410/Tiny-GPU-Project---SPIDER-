module mux #(
    parameter WIDTH = 8,       // nember of bits of inout 
    parameter N = 4            // number of inputs
)(
    input  [N*WIDTH-1:0] in,   // input pack 
    input  [$clog2(N)-1:0] sel,
    output reg [WIDTH-1:0] out
);

always @(*) begin
    out = in[sel*WIDTH +: WIDTH];
end

endmodule
