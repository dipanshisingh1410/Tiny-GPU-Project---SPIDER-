module demux (
    parameter WIDTH = 8 ,
    parameter N= 4 
)(
    input wire  [WIDTH-1:0] IN ,
    input wire [$clog2(N)-1:0] SEL ,
    output reg [N*WIDTH-1:0] OUT
);
integer i;

always @(*) begin
    out = {N*WIDTH{1'b0}};

    for (i = 0; i < N; i = i + 1) begin
        if (sel == i)
            out[i*WIDTH +: WIDTH] = in;
    end
end

endmodule
    
